ason":null,"subtitle":null,"summary":null,"title":null,"uri":"http://www.itunes.com/dtds/podcast-1.0.dtd"},{"author":"RSR - La 1ère","block":false,"closedCaptioned":false,"duration":{"milliseconds":231100},"episode":null,"episodeType":null,"explicitNullable":null,"image":null,"imageUri":null,"keywords":[],"order":null,"season":null,"subtitle":null,"summary":null,"title":null,"uri":"http://www.itunes.com/dtds/podcast-1.0.dtd"}],"pubDate":"2006-11-24T06:20:00.000Z","source":{"url":"http://www.rsr.ch/podcast.aspx?rss=capsule","value":""},"title":"Call of Duty III : en marche vers Paris","uri":"http://www.rsr.ch/capsule"},{"author":"Radio Suisse Romande","categories":[],"comments":null,"content":null,"description":{"type":"text/html","value":"Invité : Julien Brecard, coordinateur évènementiel pour Everest Poker point net.\\n\\n\\n\\nQuelques sites donnent la possibilité de passer par une école de poker gratuite et en ligne où par un logiciel  à installer. Une fois le jeu appris, vous pouvez jouer sur Texas Holden No limit, la variété de Poker la plus jouée sur le Net, qui est reconnaissable à ses cartes en amandes et ses jetons en plastique du Missouri."},"enclosures":[{"length":1742137,"type":"audio/mpeg","url":"http://podcast.rsr.ch/media/capsule/20061122-poker-en-ligne.mp3"}],"expirationDate":null,"foreignMarkup":["<itunes:author xmlns:itunes=\\"http://www.itunes.com/DTDs/Podcast-1.0.dtd\\">RSR - La 1ère</itunes:author>","<itunes:duration xmlns:itunes=\\"http://www.itunes.com/DTDs/Podcast-1.0.dtd\\">00:03:35.8</itunes:duration>"],"guid":null,"link":"http://www.rsr.ch/capsule","modules":[{"author":"RSR - La 1ère","block":false,"closedCaptioned":false,"duration":{"milliseconds":216000},"episode":null,"episodeType":null,"explicitNullable":null,"image":null,"imageUri":null,"keywords":[],"order":null,"season":null,"subtitle":null,"summary":null,"title":null,"uri":"http://www.itunes.com/dtds/podcast-1.0.dtd"},{"author":"RSR - La 1ère","block":false,"closedCaptioned":false,