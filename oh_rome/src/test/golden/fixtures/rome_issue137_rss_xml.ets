    '"<?xml version=\\"1.0\\" encoding=\\"UTF-8\\"?>\\r\\n<?xml-stylesheet type=\\"text/xsl\\" href=\\"/~d/styles/rss2full.xsl\\"?>\\r\\n<rss xmlns:atom=\\"http://www.w3.org/2005/Atom\\" version=\\"2.0\\">\\r\\n  <channel>\\r\\n    <title>Spotlight</title>\\r\\n    <link>http://www.moe.gov.sg/media/spotlight/</link>\\r\\n    <description />\\r\\n    <language>en</language>\\r\\n    <copyright>Copyright 2009</copyright>\\r\\n    <lastBuildDate>Fri, 25 Sep 2009 02:00:00 GMT</lastBuildDate>\\r\\n    <docs>http://www.rssboard.org/rss-specification</docs>\\r\\n    <atom10:link xmlns:atom10=\\"http://www .w3.org/2005/Atom\\" rel=\\"hub\\" href=\\"http://pubsubhubbub.appspot.com\\" />\\r\\n    <atom:link href=\\"http://feeds.feedburner .com/singapore-education/spotlight\\" type=\\"application/rss+xml\\" rel=\\"self\\" />\\r\\n    <item>\\r\\n      <title>Single-Session Primary Schools</title>\\r\\n      <link>http://feedproxy.google.com/~r/singapore-education/spotlight/~3/vnNsA4Hdk6U/</link>\\r\\n      <feedburner:origLink xmlns:feedburner=\\"http://rssnamespace.org/feedburner/ext/1.0\\">http://www.moe.gov.sg/media/spotlight/</feedburner:origLink>\\r\\n      <description>&lt;img src=\\"http://www.moe.gov.sg/media/spotlight/assets_c/2009/09/spotlight-single-session-thumb-120x80-282.jpg\\" alt=\\"Teacher and his students tossing frisbees into the air\\" /&gt;&lt;p&gt;MOE will be &lt;a href\\r\\n=\\"http://www.moe.gov.sg/media/press/2009/09/moe-to-build-new-primary-schoo.php\\"&gt;building 11 new primary\\r\\n schools and upgrading another 28 existing schools from November 2009&lt;/a&gt;. This is the first phase of\\r\\n MOE\'s plans to enhance primary school infrastructure to facilitate the transition of all primary schools\\r\\n to a single-session model to support a higher quality primary education.&lt;/p&gt;</description>\\r\\n      <pubDate>Fri, 25 Sep 2009 02:00:00 GMT</pubDate>\\r\\n      <guid isPermaLink=\\"false\\">http://www.moe.gov.sg/media/spotlight/</guid>\\r\\n    </item>\\r\\n    <item>\\r\\n      <title>Work Plan Seminar 2009</title>\\r\\n      <link>http://feedproxy.google.com/~r/singapore-education/spotlight/~3/vnNsA4Hdk6U/</link>\\r\\n      <feedburner:origLink xmlns:feedburner=\\"http://rssnamespace.org/feedburner/ext/1.0\\">http://www.moe.gov.sg/media/spotlight/</feedburner:origLink>\\r\\n      <description>&lt;img src=\\"http://www.moe.gov.sg/media/spotlight/assets_c/2009/09/spotlight-wps-thumb-120x80-280\\r\\n.jpg\\" alt=\\"Minister speaking at WPS 2009\\" /&gt;&lt;p&gt;At the Work Plan Seminar 2009, Minister for Education\\r\\n Dr Ng Eng Hen &lt;a href=\\"http://www.moe.gov.sg/media/speeches/2009/09/17/work-plan-seminar.php\\"&gt;talked\\r\\n about the importance of language &amp;#38; communication skills and growing a world-class education service\\r\\n&lt;/a&gt;. He spoke of &lt;a href=\\"http://www.moe.gov.sg/media/press/2009/09/teachers-the-heart-of-quality.php\\"\\r\\n&gt;strengthening the teaching track and of a teacher-driven culture of professional excellence&lt;/a&gt;.&lt;/p\\r\\n&gt;</description>\\r\\n      <pubDate>Thu, 17 Sep 2009 07:33:15 GMT</pubDate>\\r\\n      <guid isPermaLink=\\"false\\">http://www.moe.gov.sg/media/spotlight/</guid>\\r\\n    </item>\\r\\n    <item>\\r\\n      <title>Recognising School Achievements in 2009</title>\\r\\n      <link>http://feedproxy.google.com/~r/singapore-education/spotlight/~3/vnNsA4Hdk6U/</link>\\r\\n      <feedburner:origLink xmlns:feedburner=\\"http://rssnamespace.org/feedburner/ext/1.0\\">http://www.moe.gov.sg/media/spotlight/</feedburner:origLink>\\r\\n      <description>&lt;img src=\\"http://www.moe.gov.sg/media/spotlight/assets_c/2009/09/spotlight-moa-2009-thumb-120x80-278.jpg\\" alt=\\"Students at a podcast session\\" /&gt;\\r\\n &lt;p&gt;A total of 275 schools will &lt;a href=\\"http://www.moe.gov.sg/media/press/2009/09/recognising-school-achievement.php\\"&gt;receive 580 Special and Level\\r\\n Two Awards this year under the MOE Masterplan of Awards&lt;/a&gt;. These awards will be presented at the 2009\\r\\n MOE Work Plan Seminar on 17 Sep 09 by the Minister for Education, Dr Ng Eng Hen.&lt;/p&gt;</description>\\r\\n      <pubDate>Thu, 10 Sep 2009 09:00:00 GMT</pubDate>\\r\\n      <guid isPermaLink=\\"false\\">http://www.moe.gov.sg/media/spotlight/</guid>\\r\\n    </item>\\r\\n    <item>\\r\\n      <title>New Programmes in Special Assistance Plan (SAP) Schools</title>\\r\\n      <link>http://feedproxy.google.com/~r/singapore-education/spotlight/~3/vnNsA4Hdk6U/</link>\\r\\n      <feedburner:origLink xmlns:feedburner=\\"http://rssnamespace.org/feedburner/ext/1.0\\">http://www.moe.gov.sg/media/spotlight/</feedburner:origLink>\\r\\n      <description>&lt;img src=\\"http://www.moe.gov.sg/media/spotlight/assets_c/2009/09/spotlight-sap-thumb-120x80-257 .jpg\\" alt=\\"Students engaged in discussion\\" /&gt;&lt;p&gt;At the Special Assistance Plan (SAP) Seminar\\r\\n 2009 on 4 Sep 09, Ms Grace Fu,\\r\\nSenior Minister of State for Education, shared on the &lt;a href=\\"http://www.moe.gov.sg/media/press/2009\\r\\n/09/new-programmes-in-special-assistance-plan-sap-schools.php\\"&gt;new initiatives\\r\\nrolled out in &lt;abbr title=\\"Special Assistance Plan\\"&gt;SAP&lt;/abbr&gt; schools&lt;/a&gt;.&lt;/p&gt;</description>\\r\\n      <pubDate>Fri, 04 Sep 2009 01:30:00 GMT</pubDate>\\r\\n      <guid isPermaLink=\\"false\\">http://www.moe.gov.sg/media/spotlight/</guid>\\r\\n    </item>\\r\\n  </channel>\\r\\n</rss>\\r\\n"',
    '{"authors":[],"contributors":[],"descriptionEx":{"mode":null,"type":null,"value":""},"docs":"http://www.rssboard.org/rss-specification","encoding":null,"entries":[{"authors":[],"categories":[],"comments":null,"contents":[],"contributors":[],"description":{"mode":null,"type":"text/html","value":"<img src=\\"http://www.moe.gov.sg/media/spotlight/assets_c/2009/09/spotlight-single-session-thumb-120x80-282.jpg\\" alt=\\"Teacher and his students tossing frisbees into the air\\" /><p>MOE will be <a href\\n=\\"http://www.moe.gov.sg/media/press/2009/09/moe-to-build-new-primary-schoo.php\\">building 11 new primary\\n schools and upgrading another 28 existing schools from November 2009</a>. This is the first phase of\\n MOE\'s plans to enhance primary school infrastructure to facilitate the transition of all primary schools\\n to a single-session model to support a higher quality primary education.</p>"},"enclosures":[],"foreignMarkup":["<feedburner:origLink xmlns:feedburner=\\"http://rssnamespace.org/feedburner/ext/1.0\\">http://www.moe.gov.sg/media/spotlight/</feedburner:origLink>"],"link":"http://feedproxy.google.com/~r/singapore-education/spotlight/~3/vnNsA4Hdk6U/","links":[],"modules":[{"contributors":[],"coverages":[],"creators":[],"dates":["2009-09-25T02:00:00.000Z"],"descriptions":[],"formats":[],"identifiers":[],"languages":[],"publishers":[],"relations":[],"rightsList":[],"sources":[],"subjects":[],"titles":[],"types":[],"uri":"http://purl.org/dc/elements/1.1/"}],"source":null,"titleEx":{"mode":null,"type":null,"value":"Single-Session Primary Schools"},"updatedDate":null,"uri":"http://www.moe.gov.sg/media/spotlight/"},{"authors":[],"categories":[],"comments":null,"contents":[],"contributors":[],"description":{"mode":null,"type":"text/html","value":"<img src=\\"http://www.moe.gov.sg/media/spotlight/assets_c/2009/09/spotlight-wps-thumb-120x80-280\\n.jpg\\" alt=\\"Minister speaking at WPS 2009\\" /><p>At the Work Plan Seminar 2009, Minister for Education\\n Dr Ng Eng Hen <a href=\\"http://www.moe.gov.sg/media/speeches/2009/09/17/work-plan-seminar.php\\">talked\\n about the importance of language &#38; communication skills and growing a world-class education service\\n</a>. He spoke of <a href=\\"http://www.moe.gov.sg/media/press/2009/09/teachers-the-heart-of-quality.php\\"\\n>strengthening the teaching track and of a teacher-driven culture of professional excellence</a>.</p\\n>"},"enclosures":[],"foreignMarkup":["<feedburner:origLink xmlns:feedburner=\\"http://rssnamespace.org/feedburner/ext/1.0\\">http://www.moe.gov.sg/media/spotlight/</feedburner:origLink>"],"link":"http://feedproxy.google.com/~r/singapore-education/spotlight/~3/vnNsA4Hdk6U/","links":[],"modules":[{"contributors":[],"coverages":[],"creators":[],"dates":["2009-09-17T07:33:15.000Z"],"descriptions":[],"formats":[],"identifiers":[],"languages":[],"publishers":[],"relations":[],"rightsList":[],"sources":[],"subjects":[],"titles":[],"types":[],"uri":"http://purl.org/dc/elements/1.1/"}],"source":null,"titleEx":{"mode":null,"type":null,"value":"Work Plan Seminar 2009"},"updatedDate":null,"uri":"http://www.moe.gov.sg/media/spotlight/"},{"authors":[],"categories":[],"comments":null,"contents":[],"contributors":[],"description":{"mode":null,"type":"text/html","value":"<img src=\\"http://www.moe.gov.sg/media/spotlight/assets_c/2009/09/spotlight-moa-2009-thumb-120x80-278.jpg\\" alt=\\"Students at a podcast session\\" />\\n <p>A total of 275 schools will <a href=\\"http://www.moe.gov.sg/media/press/2009/09/recognising-school-achievement.php\\">receive 580 Special and Level\\n Two Awards this year under the MOE Masterplan of Awards</a>. These awards will be presented at the 2009\\n MOE Work Plan Seminar on 17 Sep 09 by the Minister for Education, Dr Ng Eng Hen.</p>"},"enclosures":[],"foreignMarkup":["<feedburner:origLink xmlns:feedburner=\\"http://rssnamespace.org/feedburner/ext/1.0\\">http://www.moe.gov.sg/media/spotlight/</feedburner:origLink>"],"link":"http://feedproxy