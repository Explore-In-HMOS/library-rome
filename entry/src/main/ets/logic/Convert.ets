import { SyndContent, SyndEntry, SyndFeed, SyndFeedInput, SyndFeedOutput, WireFeedOutput } from 'oh_rome';
import { describeError, ErrorInfo, ErrorKind } from './Errors';
import { FeedSource, parseSource } from './Source';

export class XmlResult {
  readonly xml: string | null;
  readonly error: ErrorInfo | null;

  constructor(xml: string | null, error: ErrorInfo | null) {
    this.xml = xml;
    this.error = error;
  }
}

// The feed types the library can write; OPML is left out since it needs an outline model, not a feed's entries.
export function outputTypes(): string[] {
  return WireFeedOutput.getSupportedFeedTypes().filter((t: string) => !t.startsWith('opml')).sort();
}

export function convertTo(source: FeedSource, feedType: string): XmlResult {
  let feed: SyndFeed;
  try {
    feed = parseSource(source);
  } catch (e) {
    return new XmlResult(null, describeError(ErrorKind.PARSE, e as Object));
  }
  feed.feedType = feedType;
  try {
    return new XmlResult(new SyndFeedOutput().outputString(feed), null);
  } catch (e) {
    return new XmlResult(null, describeError(ErrorKind.CONVERT, e as Object));
  }
}

// A feed built from scratch through SyndFeed, the way an app would publish one.
export function generateFeed(feedType: string, title: string, entryTitle: string, now: Date): XmlResult {
  const feed = new SyndFeed();
  feed.feedType = feedType;
  feed.title = title;
  feed.link = 'https://example.com/';
  feed.description = 'Generated by the oh_rome demo';
  feed.language = 'en';
  feed.publishedDate = now;
  const entries: SyndEntry[] = [];
  for (let i = 1; i <= 2; i++) {
    const entry = new SyndEntry();
    entry.title = i === 1 ? entryTitle : 'Second entry';
    entry.link = `https://example.com/${i}`;
    entry.uri = `https://example.com/${i}`;
    entry.publishedDate = new Date(now.getTime() - (i - 1) * 3600 * 1000);
    const description = new SyndContent();
    description.type = 'text/plain';
    description.value = `Entry ${i} of a generated ${feedType} feed.`;
    entry.description = description;
    entries.push(entry);
  }
  feed.entries = entries;
  try {
    return new XmlResult(new SyndFeedOutput().outputString(feed), null);
  } catch (e) {
    return new XmlResult(null, describeError(ErrorKind.CONVERT, e as Object));
  }
}

// Reads generated XML back, as a check that the output is a feed the library itself accepts. DOCTYPEs are allowed here:
// rss_0.91N output carries one (RSS091NetscapeGenerator), and the default input rejects it, as ROME's does.
export function readBack(xml: string): string {
  try {
    const input = new SyndFeedInput();
    input.allowDoctypes = true;
    const feed = input.build(xml);
    const doctype = xml.includes('<!DOCTYPE') ? ' (has a DOCTYPE: the default input would reject it)' : '';
    return `Read back as ${feed.feedType}: "${feed.title ?? ''}", ${feed.entries.length} entries${doctype}`;
  } catch (e) {
    const error = describeError(ErrorKind.PARSE, e as Object);
    return `Reading it back failed: ${error.name}: ${error.message}`;
  }
}
